{
  "name": "wxt-web-extension-react-ts-boilerplate",
  "description": "manifest.json description",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "node node_modules/typescript/bin/tsc --noEmit",
    "postinstall": "wxt prepare",
    "prepare": "husky",
    "test:security": "node --test scripts/security/verify-node-forge-security.cjs"
  },
  "dependencies": {
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
